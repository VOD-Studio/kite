{
  "name": "@violetjs/kite-player",
  "version": "0.1.0",
  "description": "kite 网页播放器:播放核心、Web Component 界面与 React hooks,配合 kite-server 公开模式(/player/v1)使用",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VOD-Studio/kite.git",
    "directory": "packages/kite-player"
  },
  "homepage": "https://github.com/VOD-Studio/kite/blob/main/docs/player.md",
  "keywords": [
    "music",
    "player",
    "web-component",
    "netease",
    "kite"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/kite-player.iife.js",
  "jsdelivr": "./dist/kite-player.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/element.js",
    "./dist/kite-player.iife.js"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "happy-dom": "^20.0.0",
    "react": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
