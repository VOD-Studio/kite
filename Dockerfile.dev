# 仅用于本地开发与验证;应用镜像仍由 Dockerfile / Dockerfile.release 构建。
# 版本由 scripts/docker-dev.sh 从 go.mod / Makefile 传入,基础镜像固定多架构摘要。
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node
FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61

ARG GO_VERSION
ARG NODE_VERSION
ARG GOLANGCI_LINT_VERSION
ARG BUF_VERSION
ARG LOCAL_UID=1000
ARG LOCAL_GID=1000
ARG GOPROXY=https://proxy.golang.org,direct

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && test "$(go env GOVERSION)" = "go${GO_VERSION}" \
    && test "$(node -p 'process.versions.node.split(".")[0]')" = "${NODE_VERSION}"

RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/*.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates curl git jq make python3 shellcheck \
       libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
       libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
       libgbm1 libpango-1.0-0 libcairo2 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# 构建工具的缓存不混入源码;项目依赖另由运行时 volume 缓存。
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOBIN=/usr/local/bin GOPROXY="${GOPROXY}" GOTOOLCHAIN=local GOMAXPROCS=4 \
      go install -p 4 "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}" \
    && GOBIN=/usr/local/bin GOPROXY="${GOPROXY}" GOTOOLCHAIN=local GOMAXPROCS=4 \
      go install -p 4 "github.com/bufbuild/buf/cmd/buf@v${BUF_VERSION}"

ARG PYYAML_VERSION
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/kite-python \
    && /opt/kite-python/bin/python -m pip install --disable-pip-version-check --only-binary=:all: "PyYAML==${PYYAML_VERSION}"

# 按宿主机 UID/GID 写文件,避免 Linux 上的源码目录出现 root 所有的生成物。
RUN groupadd --non-unique --gid "${LOCAL_GID}" kite \
    && useradd --non-unique --uid "${LOCAL_UID}" --gid "${LOCAL_GID}" --create-home --shell /bin/bash kite \
    && mkdir -p /workspace/packages/kite-player/node_modules /workspace/interop/rust/target \
       /home/kite/go/pkg/mod /home/kite/.cache/go-build /home/kite/.cache/ms-playwright /home/kite/.npm \
    && chown -R "${LOCAL_UID}:${LOCAL_GID}" /workspace /home/kite

ENV HOME=/home/kite \
    GOPATH=/home/kite/go \
    GOMODCACHE=/home/kite/go/pkg/mod \
    GOCACHE=/home/kite/.cache/go-build \
    npm_config_cache=/home/kite/.npm \
    PATH=/opt/kite-python/bin:/home/kite/go/bin:${PATH} \
    GOTOOLCHAIN=local
USER kite
WORKDIR /workspace
CMD ["bash"]
